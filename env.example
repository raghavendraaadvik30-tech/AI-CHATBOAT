# Copy this file to ".env" (same folder as server.mjs) and fill in your keys.
# ".env" is git-ignored and never served to the browser, so your keys stay private.
# Restart the server (Ctrl+C, then: node server.mjs) after editing.

# Realistic human avatar — https://app.talking-avatar.dev
TALKING_AVATAR_API_KEY=tav_your_key_here
TALKING_AVATAR_ID=your_avatar_id_from_quickstart

# Indian-language voice (also used by the realistic avatar) — https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here

# Image generation — Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_token
